{
  "name": "tt-crew-app-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @tt-crew-app/web dev",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @tt-crew-app/web db:generate",
    "db:migrate": "pnpm --filter @tt-crew-app/web db:migrate",
    "db:push": "pnpm --filter @tt-crew-app/web db:push",
    "db:push:remote": "pnpm --filter @tt-crew-app/web db:push:remote",
    "db:studio": "pnpm --filter @tt-crew-app/web db:studio",
    "postgres:docker": "pnpm --filter @tt-crew-app/web postgres:docker",
    "infra:dev": "sst dev",
    "infra:build": "sst build",
    "infra:deploy": "sst deploy",
    "infra:remove": "sst remove",
    "infra:console": "sst console"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@next/eslint-plugin-next": "^15.3.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-sonarjs": "^3.0.2",
    "globals": "^16.0.0",
    "sst": "^3.4.49",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.29.1"
  },
  "resolutions": {
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3"
  }
}